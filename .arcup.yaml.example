# arcup Example Configuration
# Copy to ~/.arcup.yaml and customize

name: my-backup
output-dir: /tmp/arcup
keep: 3
dry-run: false

sources:
  - /home/user/documents
  - /home/user/projects

algo: zstd
algo-args: ""

upload-to: rclone
remote: "s3:my-bucket/backups"

# Watch mode (use with: arcup run -w)
watch: false
interval: "@daily"   # or "6h", "30m", "@weekly"

# Retry settings (for archive creation and upload)
retry:
  max-attempts: 3
  delay: "1m"

# Retention (runs after each backup if set)
retention:
  keep-days: 7
  keep-last: 5
